    "changes": [
      "BA_REALTIME passes 120 to the unchanged BA_RUN_REALTIME and emits audit after playback",
      "BA_RUN iterates 0..119, waits for 120/30 seconds, reports 120; its actual sequential render/present body is unchanged"
    ],
    "full_data_frame_constant_unchanged": true,
    "diff": "--- production PLAYER.ERB\n+++ isolated short-test PLAYER.ERB\n@@ -332,7 +332,7 @@\n SETCOLOR 255, 255, 255\n SETBGCOLOR 0, 0, 0\n BA_STARTMS = GETMILLISECOND()\n-FOR LF, 0, BA_FRAMES\n+FOR LF, 0, 120\n     LTIME = GETMILLISECOND()\n     CALL BA_RENDER, LF\n     BA_CALCMS += GETMILLISECOND() - LTIME\n@@ -354,7 +354,7 @@\n     ENDIF\n NEXT\n IF LPACED\n-    LW = BA_STARTMS + BA_FRAMES * 1000 / BA_FPS - GETMILLISECOND()\n+    LW = BA_STARTMS + 120 * 1000 / BA_FPS - GETMILLISECOND()\n     SIF LW > 0\n         AWAIT LW\n ENDIF\n@@ -362,7 +362,7 @@\n CLEARLINE BA_SHOWN\n BA_SHOWN = 0\n REDRAW 3\n-PRINTFORML Completed {BA_FRAMES} / {BA_FRAMES} frames. Elapsed: {BA_ELAPSEDMS} ms.\n+PRINTFORML Completed {120} / {120} frames. Elapsed: {BA_ELAPSEDMS} ms.\n PRINTFORML Calculation and row construction: {BA_CALCMS} ms; presentation: {BA_PRESENTMS} ms.\n SIF LPACED\n     PRINTFORML Maximum lateness: {BA_MAXLATE} ms; late by over one frame: {BA_LATEFRAMES}.\n@@ -396,8 +396,8 @@\n ; and the curve chains of spans alive at the selected target.\n ; GETMILLISECOND is the engine's wall-clock query, not a monotonic clock.\n @BA_REALTIME\n-BA_RT_AUDIT = 0\n-CALL BA_RUN_REALTIME, BA_FRAMES\n+BA_RT_AUDIT = 1\n+CALL BA_RUN_REALTIME, 120\n RETURN RESULT\n \n ; Identical movie loop; only the post-movie diagnostic emission differs.\n"
  },
