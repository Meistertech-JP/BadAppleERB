; Runtime state. GEOMETRY.ERH supplies only contour and grayscale trajectories.
; All coordinates and gray values are computed by ordinary ERB integer math.
#DIM BA_HEAD, 24
#DIM BA_NEXT, BA_TRACKS
#DIM BA_PREV, BA_TRACKS
#DIM BA_NODE_ROW, BA_TRACKS
#DIM BA_P_POS, BA_TRACKS * 3
#DIM BA_P_START, BA_TRACKS * 3
#DIM BA_P_LAST, BA_TRACKS * 3
#DIM BA_P_COEF, BA_TRACKS * 3
#DIMS BA_LEFT_DATA, BA_TRACKS
#DIMS BA_RIGHT_DATA, BA_TRACKS
#DIMS BA_GRAY_DATA, BA_TRACKS
#DIMS BA_META_DATA, BA_TRACKS
#DIMS BA_DEATH_DATA, BA_FRAMES + 1
#DIM BA_LOADED
#DIM BA_BIRTH_POS
#DIM BA_EVENT_FRAME
#DIMS BA_ROW, 24
#DIMS BA_TRACE, 24
#DIMS BA_FONT, 256
#DIMS BA_HEXRUN, 256
#DIMS BA_BLANK
#DIMS BA_INK
#DIMS BA_BLANKRUN, 80
#DIMS BA_INKRUN, 80
#DIM BA_CAPTURE
#DIM BA_SHOWN
#DIM BA_FRAME
#DIM BA_STARTMS
#DIM BA_ELAPSEDMS
#DIM BA_MAXLATE
#DIM BA_LATEFRAMES

#DIM BA_CALCMS
#DIM BA_PRESENTMS

